# Copy to terraform.tfvars and fill in.

# No default (FZ-135, D-32). us-east-2 is the decision; stating it here means nobody
# inherits a region, which cannot be changed later without re-creating every identity.
region = "us-east-2"

# The account this estate may be applied into. Every provider asserts it, so an apply with
# the wrong credentials fails before creating anything (FZ-175) — which is not theoretical:
# `aws login` writes a session only the AWS CLI can read, so Terraform silently fell through
# to the [default] profile and applied into a personal account with root access keys.
aws_account_id = "123456789012"

# The SPA's hostname, and the API's — the latter is what Caddy requests a certificate for.
# Stated separately rather than derived (FZ-174). Must match what ../shared was applied with.
domain_name     = "app.freezehub.example"
api_domain_name = "api.freezehub.example"
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# From the other estate: `terraform -chdir=../shared output -raw ecr_repository_arn`.
# The instance may pull from this repository and no other.
ecr_repository_arn = "arn:aws:ecr:us-east-2:123456789012:repository/freezehub-beta-backend"

# 2 GB carries the measured 353 MiB working set (D-28) plus PostgreSQL. t4g.medium buys a
# second replica and removes the ~15s deploy gap.
# instance_type = "t4g.small"
