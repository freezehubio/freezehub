# Copy to terraform.tfvars and fill in. Everything else has a working default.

# The region this estate runs in. The user pool is the part that matters: it is region-bound,
# and the `sub` it issues is what `users.external_subject` stores. Only the CloudFront
# certificate lives elsewhere, in us-east-1, because AWS accepts it from nowhere else; a
# certificate holds no customer data.
#
# There is no default (FZ-135). It cannot be changed after the first apply without moving
# the database and re-creating every identity. Apply this module first: both compute
# postures take their values from its outputs.
#
# Decided: us-east-2 (`D-32`). It is the region the project is assigned, and the SCP denies
# Cognito, RDS, ECR, SSM and load balancers everywhere else. Still the United States, so the
# residency answer is unchanged; an EU buyer still gets "no".
region = "us-east-2"

# The domain the SPA is served from, and separately the one the Policy API is served from.
# The API hostname is stated rather than derived (FZ-174): it is the URL that ends up in
# every customer's CI configuration through freeze-check.sh, so it should not inherit
# whatever subdomain the SPA happens to use. Both are certificate subject names and cannot
# be changed after the first apply without reissuing.
domain_name     = "app.freezehub.example"
api_domain_name = "api.freezehub.example"

# A Route 53 hosted zone that already delegates that domain. Both certificates are
# validated through it, so it must exist before the first apply.
hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# environment = "beta"

# owner/name of the repository allowed to deploy. The OIDC trust policy is scoped to it and
# to master, so getting this wrong is the difference between only this repository deploying
# and anyone's doing so.
# github_repository = "freezehubio/freezehub"

# The GitHub Actions OIDC provider and deploy role. Off by default: this account denies
# iam:*Provider* through a service control policy that cannot be modified (OI-43), so an
# apply with this on fails on the first resource. Turn it on after activating advanced
# features (D-37), then apply again — nothing else in this module changes.
# github_oidc_enabled = true
