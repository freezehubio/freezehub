<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.freezhub</groupId>
    <artifactId>freezehub-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>freezehub-backend</name>
    <description>FreezeHub backend - modular monolith</description>

    <properties>
        <java.version>21</java.version>
        <!--
            Ahead of the Boot 4.1.1 default of 11.0.24, which carries three CRITICALs
            (FZ-136). A patch bump inside 11.0.x, pinned here rather than waited for,
            because the alternative is shipping them or suppressing them.
        -->
        <tomcat.version>11.0.25</tomcat.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
            Spring Boot 4 split RestClient support out of the web starter, so the
            customizer that carries the outbound timeouts (`FZ-065`, `D-30`) needs this
            module named explicitly (`FZ-136`). It brings `spring-boot-http-client` with it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!--
            The payment provider's own SDK (FZ-084).

            Added rather than hand-rolled for one reason above the others: Webhook
            .constructEvent is the reference implementation of signature verification,
            including the timestamp tolerance that stops a captured delivery being
            replayed. Getting that subtly wrong in our own code would be a security bug in
            the one place entitlement changes, and payment integration is the wrong place
            to save a dependency.
        -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>29.2.0</version>
        </dependency>

        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!--
            Spring Boot 4 moved Liquibase's auto-configuration into its own module, and
            `liquibase-core` alone no longer runs the changelog at startup (`FZ-136`).
            Without this the application starts against an empty schema — which is exactly
            how it failed: 342 tests erroring with `relation "organization" does not exist`.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            The only AWS dependency in the backend (`FZ-046`). Everything else here is
            cloud-neutral and `OI-15` records that as worth keeping, so this is the narrow
            service module rather than a bundle, and it is reachable through one class behind
            the `IdentityProvider` port. The alternative is not "no AWS code": Cognito's admin
            API cannot be called without SigV4, so hand-rolling the signature would be more
            AWS-specific code, not less.

            The two bundled HTTP clients are excluded in favour of `url-connection-client`,
            which is a fraction of the size. This application makes one call, at invite time.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cognitoidentityprovider</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 moved MockMvc's auto-configuration out of `spring-boot-starter-test`
            into its own module (`FZ-136`). Every `@SpringBootTest` that drives HTTP needs it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            `@DataJpaTest` and `@AutoConfigureTestDatabase` moved into per-technology test
            modules in Spring Boot 4 (`FZ-136`).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        Spring Boot 4 no longer manages Testcontainers versions, so the two test
        dependencies above lost theirs and the POM stopped resolving (FZ-136). The BOM is
        imported here rather than a version pinned on each dependency, so the modules stay
        in step with each other the way the Boot parent used to keep them.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>2.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                The AWS SDK, imported the same way and for the same reason: the service
                module, the core and the HTTP client must be one version, and pinning each
                separately is how they drift.
            -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.46.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
